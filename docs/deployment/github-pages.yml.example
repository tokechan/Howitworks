# Inactive template. Activate only after choosing the repository and approving
# the GitHub setup: copy to .github/workflows/pages.yml on the default branch.
# Official action refs checked on 2026-10-28; full SHAs keep this template stable.
name: GitHub Pages (manual)

on:
  workflow_dispatch:
    inputs:
      publish:
        description: 'Deploy the checked build to the public GitHub Pages site'
        type: boolean
        required: true
        default: false

permissions:
  contents: read

concurrency:
  group: github-pages
  cancel-in-progress: false

jobs:
  build:
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pages: read
    steps:
      - name: Check out source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false

      - name: Read Pages URL settings
        id: pages
        uses: actions/configure-pages@45bfe0192ca1faeb007ade9deae92b16b8254a0d # v6.0.0
        with:
          enablement: false

      - name: Set up Node.js
        uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7
        with:
          node-version: '26.13.1'
          cache: npm
          cache-dependency-path: |
            site/package-lock.json
            talks/brotli/package-lock.json

      - name: Restore locked dependencies
        run: |
          npm --prefix site ci
          npm --prefix talks/brotli ci

      - name: Build blog, simulator, slides and search
        env:
          SITE_ORIGIN: ${{ steps.pages.outputs.origin }}
          SITE_BASE: ${{ steps.pages.outputs.base_path }}/
          INCLUDE_DRAFTS: '0'
        run: |
          npm --prefix site run build
          npm --prefix site run check

      - name: Check release content
        if: inputs.publish
        env:
          SITE_BASE: ${{ steps.pages.outputs.base_path }}/
        run: npm --prefix site run check -- --release

      - name: Upload the assembled site
        uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5.0.0
        with:
          path: site/.generated/base-site
          retention-days: 7
          include-hidden-files: true

  deploy:
    if: inputs.publish
    needs: build
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346 # v5.0.1
