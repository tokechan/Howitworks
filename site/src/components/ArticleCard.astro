---
import { href } from '../../scripts/config.mjs';
import { date, topicSlug } from '../lib/content';
const { article, index = 1 } = Astro.props;
const { data, id } = article;
---
<article class="article-card">
  <div class="article-number">{String(index).padStart(2, '0')}<span>NOTE</span></div>
  <div class="article-card-body">
    <div class="meta-row"><time datetime={data.updatedAt}>{date(data.updatedAt)}</time><span>更新</span>{data.status === 'draft' && <span class="draft-label">下書き</span>}</div>
    <h2><a href={href(`articles/${id}/`)}>{data.title}<span aria-hidden="true">↗</span></a></h2>
    <p>{data.description}</p>
    <div class="tag-row">{data.tags.map((tag: string) => <a class="tag" href={href(`topics/${topicSlug(tag)}/`)}>{tag}</a>)}</div>
    <div class="article-formats"><span class="format-label"><i class="dot blue"></i>解説記事</span>{data.simulator && <a href={href(`labs/${data.simulator}/`)}><i class="dot mint"></i>シミュレーター <span>↗</span></a>}{data.talk && <a href={href(`talks/${data.talk}/`)}><i class="dot coral"></i>5分LT <span>↗</span></a>}</div>
  </div>
</article>
