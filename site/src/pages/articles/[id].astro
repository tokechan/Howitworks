---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ResourceLinks from '../../components/ResourceLinks.astro';
import { articles, date, topicSlug } from '../../lib/content';
import { href } from '../../../scripts/config.mjs';
export async function getStaticPaths() { return (await articles()).map(article => ({ params: { id: article.id }, props: { article } })); }
const { article } = Astro.props;
const { data } = article;
const { Content, headings } = await render(article);
const toc = headings.filter(h => h.depth === 2);
---
<Base title={data.title} description={data.description}>
  <nav class="breadcrumb" aria-label="パンくず"><a href={href()}>ホーム</a><span>/</span><a href={href('articles/')}>記事</a><span>/</span><span>{data.aliases[0] || data.title}</span></nav>
  <article data-pagefind-body data-pagefind-filter="kind:記事">
    <header class="article-header">
      <p class="eyebrow">HOW IT WORKS <span>／</span> RESEARCH NOTE</p>
      <div class="tag-row">{data.tags.map(tag => <a class="tag" data-pagefind-filter="tag" href={href(`topics/${topicSlug(tag)}/`)}>{tag}</a>)}{data.status === 'draft' && <span class="draft-label">下書き</span>}</div>
      <h1 data-pagefind-meta="title">{data.title}</h1>
      <p class="article-question">{data.question}</p>
      <div class="article-dates"><span>更新 <time datetime={data.updatedAt} data-pagefind-meta="date">{date(data.updatedAt)}</time></span><span>情報確認 <time datetime={data.verifiedAt}>{date(data.verifiedAt)}</time></span><span>実測＋一次資料</span></div>
      <ResourceLinks simulator={data.simulator} talk={data.talk} small />
    </header>
    <div class="article-layout">
      <div class="article-main">
        <details class="mobile-toc"><summary>この記事の目次</summary><ol>{toc.map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></details>
        <div class="prose"><Content /></div>
        <section class="verification-note"><p class="eyebrow">LAST VERIFIED · {date(data.verifiedAt)}</p><h2>情報の確認範囲</h2><p>{data.verificationScope}</p></section>
        <section class="related-terms"><h2>別名・関連する言葉</h2><p>{data.aliases.join(' / ')}</p></section>
        <div class="article-end" data-pagefind-ignore><p class="eyebrow">KEEP EXPLORING</p><h2>もう一度、動かしてみる。</h2><ResourceLinks simulator={data.simulator} talk={data.talk} small /><a class="text-link" href={href('articles/')}>← 記事一覧に戻る</a></div>
      </div>
      <aside class="toc" aria-label="この記事の目次" data-pagefind-ignore><div class="toc-sticky"><span class="eyebrow">ON THIS PAGE</span><ol>{toc.map((h,i) => <li><a href={`#${h.slug}`}><span>{String(i+1).padStart(2,'0')}</span>{h.text}</a></li>)}</ol><a class="toc-top" href="#main">ページの先頭へ ↑</a></div></aside>
    </div>
  </article>
  <script>
    const diagrams = document.querySelectorAll('.mermaid');
    if (diagrams.length) {
      const observer = new IntersectionObserver(async entries => {
        if (!entries.some(e => e.isIntersecting)) return;
        observer.disconnect();
        try {
          const { default: mermaid } = await import('mermaid');
          mermaid.initialize({ startOnLoad: false, securityLevel: 'strict', theme: 'base', themeVariables: { fontFamily: 'Noto Sans JP Variable, sans-serif', primaryColor: '#e7f7f3', primaryTextColor: '#183b63', primaryBorderColor: '#8dd8c8', lineColor: '#66758a', secondaryColor: '#d3e1fc', tertiaryColor: '#fff4d6' } });
          await mermaid.run({ nodes: Array.from(diagrams) as HTMLElement[] });
        } catch { /* Keep the source diagram readable if rendering fails. */ }
      }, { rootMargin: '400px' });
      diagrams.forEach(el => observer.observe(el));
    }
    const sections = document.querySelectorAll('.prose h2[id]');
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) if (entry.isIntersecting) {
        document.querySelectorAll('.toc a').forEach(link => link.classList.toggle('active', link.getAttribute('href') === '#' + entry.target.id));
      }
    }, { rootMargin: '-80px 0px -65% 0px' });
    sections.forEach(el => observer.observe(el));
  </script>
</Base>
