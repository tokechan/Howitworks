---
import '@fontsource-variable/inter';
import '@fontsource-variable/noto-sans-jp';
import '../styles/site.css';
import { href } from '../../scripts/config.mjs';
const { title = 'Howitworks — しくみを、自分の言葉に。', description = 'ソフトウェア開発の「なんで？」を、調べて、動かして、自分の言葉で残す個人のナレッジノート。', wide = false } = Astro.props;
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title.includes('Howitworks') ? title : `${title} · Howitworks`}</title>
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <a class="brand" href={href()} aria-label="Howitworks ホーム"><span class="brand-icon" aria-hidden="true">h<span>↗</span></span><span>Howitworks<span class="brand-dot">.</span></span></a>
      <nav aria-label="メインナビゲーション">
        <a href={href('articles/')} aria-current={current.startsWith(href('articles/')) ? 'page' : undefined}>記事</a>
        <a href={href('topics/')} aria-current={current.startsWith(href('topics/')) ? 'page' : undefined}>テーマ</a>
        <a class="about-nav" href={href('about/')} aria-current={current === href('about/') ? 'page' : undefined}>このサイトについて</a>
        <a class="nav-search" href={href('search/')} aria-label="サイト内検索"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.8"/></svg><span>検索</span><kbd>⌘ K</kbd></a>
      </nav>
    </header>
    <main id="main" class:list={['main', { wide }]} tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div><a class="footer-brand" href={href()}>Howitworks.</a><p>調べる。動かす。自分の言葉にする。</p></div>
      <div class="footer-links"><a href={href('about/')}>このサイトについて</a><a href={href('search/')}>検索</a><span>PERSONAL KNOWLEDGE NOTES</span></div>
    </footer>
    <script define:vars={{ searchUrl: href('search/') }}>
      document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault(); location.href = searchUrl;
        }
      });
    </script>
  </body>
</html>
