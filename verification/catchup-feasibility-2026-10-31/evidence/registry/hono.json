  "latestStable": {
    "version": "4.13.14",
    "publishedAt": "2026-10-25T07:19:30.732Z",
    "engines": {
      "node": ">=16.9.0"
    },
    "scripts": {
      "lint": "vp lint src runtime-tests build perf-measures benchmarks adapters",
      "test": "tsc -p tsconfig.spec.json && vp test --run",
      "build": "pnpm run remove-dist && vp pack && pnpm run copy:package.cjs.json && publint",
      "check": "vp check",
      "watch": "pnpm run remove-dist && vp pack --watch && pnpm run copy:package.cjs.json",
      "format": "vp fmt --check \"src/**/*.{js,ts,tsx}\" \"runtime-tests/**/*.{js,ts,tsx}\" \"build/**/*.{js,ts,tsx}\" \"perf-measures/**/*.{js,ts,tsx}\" \"benchmarks/**/*.{js,ts,tsx}\" \"adapters/**/*.{js,ts,tsx}\"",
      "release": "np --no-publish",
      "coverage": "vp test --run --coverage",
      "lint:fix": "vp lint --fix src runtime-tests build perf-measures benchmarks adapters",
      "test:all": "pnpm run test && pnpm run test:deno && pnpm run test:bun",
      "test:bun": "bun test --jsx-import-source ../../src/jsx runtime-tests/bun",
      "check:fix": "vp check --fix",
      "test:deno": "deno test --allow-read --allow-env --allow-write --allow-net -c runtime-tests/deno/deno.json runtime-tests/deno && deno test --no-lock -c runtime-tests/deno-jsx/deno.precompile.json runtime-tests/deno-jsx && deno test --no-lock -c runtime-tests/deno-jsx/deno.react-jsx.json runtime-tests/deno-jsx",
      "test:node": "vp test --run --project node",
      "format:fix": "vp fmt \"src/**/*.{js,ts,tsx}\" \"runtime-tests/**/*.{js,ts,tsx}\" \"build/**/*.{js,ts,tsx}\" \"perf-measures/**/*.{js,ts,tsx}\" \"benchmarks/**/*.{js,ts,tsx}\" \"adapters/**/*.{js,ts,tsx}\"",
      "prerelease": "pnpm run test:deno && pnpm run build",
      "test:watch": "vp test --watch",
      "remove-dist": "rm -rf dist",
      "test:fastly": "vp test --run --project fastly",
      "test:workerd": "vp test --run --project workerd",
      "test:adapters": "pnpm -r --filter \"./adapters/*\" run test",
      "build:adapters": "pnpm -r --filter \"./adapters/*\" run build",
      "release:adapter": "node ./build/release-adapter.ts",
      "editorconfig-checker": "editorconfig-checker",
      "copy:package.cjs.json": "cp ./package.cjs.json ./dist/cjs/package.json && cp ./package.cjs.json ./dist/types/package.json"
    },
    "dist": {
      "shasum": "234489b07bd7bb7b069c9e362f4d39ca85376638",
